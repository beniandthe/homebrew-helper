{
  "expo": {
    "name": "Homebrew Helper",
    "slug": "rpg-toolkit",
    "scheme": "rpgtoolkit",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.benjaminrossman.rpgtoolkit"
    },
    "android": {
      "package": "com.benjaminrossman.rpgtoolkit"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dcc6cca0-f60f-4c04-9b44-c20824049593"
      }
    },
    "owner": "rossmanbens-organization"
  }
}
